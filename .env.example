SECRET_KEY=replace-with-a-long-random-secret-key-that-is-at-least-50-chars
DEBUG=False
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
ALLOWED_HOSTS=your-project.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-project.up.railway.app
DATABASE_URL=postgres://user:password@host:port/dbname
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=webmaster@localhost
SERVER_EMAIL=webmaster@localhost
EMAIL_REPLY_TO=

# Storage privado: filesystem para desarrollo/tests; s3 para producción.
PRIVATE_STORAGE_BACKEND=filesystem
PRIVATE_STORAGE_S3_BUCKET=
PRIVATE_STORAGE_S3_ENDPOINT_URL=
PRIVATE_STORAGE_S3_REGION_NAME=
PRIVATE_STORAGE_S3_ACCESS_KEY_ID=
PRIVATE_STORAGE_S3_SECRET_ACCESS_KEY=
PRIVATE_STORAGE_S3_QUERYSTRING_EXPIRE=300
# Backup PostgreSQL custom: ruta absoluta externa al repositorio, sin secretos.
BACKUP_OUTPUT_ROOT=/var/lib/scviajes/backups
BACKUP_MINIMUM_COPIES=7
BACKUP_RETENTION_DAYS=30
BACKUP_REQUIRE_ENCRYPTION=False
# BACKUP_ENCRYPTION_TOOL=/usr/bin/proveedor-de-cifrado
# Configurar únicamente fuera del repositorio; se dejan vacías para no sugerir datos reales.
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_ALIAS=
BANK_TRANSFER_CVU=
BANK_TRANSFER_CUIT=
BANK_TRANSFER_ENTITY=
PAYMENTS_PROOF_WINDOW_MINUTES=5
PAYMENTS_REVIEW_WINDOW_HOURS=24

# OAuth de Google (opcional; no incluir secretos reales)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SIMULATION_ENABLED=False
# Apple OIDC (opcional; nunca guardar credenciales reales en el repositorio)
APPLE_OIDC_CLIENT_ID=
APPLE_OIDC_TEAM_ID=
APPLE_OIDC_KEY_ID=
APPLE_OIDC_PRIVATE_KEY=
APPLE_OIDC_ENABLED=False
APPLE_OIDC_SIMULATION_ENABLED=False
APPLE_OIDC_AUTHORIZATION_URL=https://appleid.apple.com/auth/authorize
APPLE_OIDC_TOKEN_URL=https://appleid.apple.com/auth/token
APPLE_OIDC_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_OIDC_ISSUER=https://appleid.apple.com
APPLE_OIDC_JWKS_CACHE_SECONDS=3600
APPLE_OIDC_STATE_TTL_SECONDS=600
CUSTOMERS_CLAIM_TOKEN_HOURS=24

# Correos transaccionales (no son marketing; no requieren consentimiento comercial).
TRANSACTIONAL_NOTIFICATIONS_ENABLED=True
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_RETRY_DELAY_SECONDS=300
NOTIFICATIONS_LEASE_SECONDS=300

# Cron futuro de mantenimiento (sin Celery/Redis; usar un job efímero de Railway)
OPERATIONAL_MAINTENANCE_MAX_LIMIT=100
OPERATIONAL_MAINTENANCE_MAX_SECONDS=30
OPERATIONAL_MAINTENANCE_LEASE_SECONDS=900
OPERATIONAL_MAINTENANCE_ENABLE_EXPIRE=True
OPERATIONAL_MAINTENANCE_ENABLE_PAYMENTS=True
OPERATIONAL_MAINTENANCE_ENABLE_FULFILLMENT=True
OPERATIONAL_MAINTENANCE_ENABLE_NOTIFICATIONS=True
# Ejemplo: python manage.py run_operational_maintenance --task all --limit 100
# Worker residente separado del proceso web; cron externo: usar --once.
MAINTENANCE_WORKER_INTERVAL_SECONDS=60
MAINTENANCE_WORKER_JITTER_SECONDS=5
MAINTENANCE_WORKER_MAX_CYCLE_SECONDS=30
MAINTENANCE_WORKER_LOCK_WAIT_SECONDS=0
MAINTENANCE_WORKER_ENABLED=True
MAINTENANCE_WORKER_MODE=resident
# python manage.py run_maintenance_worker --once

# Protecci�n distribuida antiabuso (contadores hash-only en la base)
ABUSE_VERIFY_LIMIT=30
ABUSE_VERIFY_WINDOW_SECONDS=60
ABUSE_TRANSFER_LIMIT=5
ABUSE_TRANSFER_WINDOW_SECONDS=600
ABUSE_CHECKOUT_LIMIT=3
ABUSE_CHECKOUT_WINDOW_SECONDS=900
ABUSE_COUNTER_RETENTION_SECONDS=86400
ABUSE_COUNTER_CLEANUP_LIMIT=1000
